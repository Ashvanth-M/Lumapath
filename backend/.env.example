# LumaPath AI backend — copy to .env and fill in.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Same project the frontend points at.
SUPABASE_URL=https://your-project.supabase.co

# Project Settings → API → service_role. This key BYPASSES Row Level Security,
# so every endpoint must check ownership itself. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → API → JWT Settings → JWT Secret.
# Used to verify the access token the frontend sends on each request.
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=500
