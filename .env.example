# LumaPath AI — environment variables
# Copy this file to .env.local and fill in your own values.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project Settings → API in the Supabase dashboard.
# The anon key is safe to expose in the browser bundle; all access is governed
# by the Row Level Security policies in supabase/migrations/002_rls.sql.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Supabase service role (server only — NEVER prefix with VITE_)
# ---------------------------------------------------------------------------
# Bypasses RLS. Used only by server functions. Anything prefixed with VITE_ is
# inlined into the client bundle, which would expose this key to every visitor.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Backend API (optional — see backend/)
# ---------------------------------------------------------------------------
# The FastAPI service that persists analyses and will host server-side ML.
# Leave unset to keep talking to Supabase directly from the browser.
VITE_BACKEND_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI copilot (optional — the /assistant page is disabled without it)
# ---------------------------------------------------------------------------
LOVABLE_API_KEY=your-lovable-gateway-key

# ---------------------------------------------------------------------------
# Demo mode (optional)
# ---------------------------------------------------------------------------
# When "true", the assessment service returns sample data instead of querying
# Supabase. Useful for UI work without a database. Leave unset in production.
VITE_DEMO_MODE=false
